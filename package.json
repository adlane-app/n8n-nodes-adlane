{
	"name": "n8n-nodes-adlane",
	"version": "3.1.0",
	"description": "Native Adlane REST API integration for n8n workflows.",
	"license": "MIT",
	"homepage": "https://adlane.app",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"adlane",
		"oauth",
		"automation"
	],
	"author": {
		"name": "Adlane",
		"url": "https://adlane.app",
		"email": "saeedmshdi@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adlane-app/n8n-nodes-adlane.git"
	},
	"bugs": {
		"url": "https://github.com/adlane-app/n8n-nodes-adlane/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint && eslint . --max-warnings=0",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test tests/*.test.cjs",
		"prepublishOnly": "npm test && npm run review",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"review": "npm run format:check && npm run lint && node scripts/review.mjs"
	},
	"files": [
		"dist",
		"examples"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AdlaneOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Adlane/Adlane.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.51.4",
		"@n8n/scan-community-package": "0.38.0",
		"@types/node": "22.19.15",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
