{
	"name": "n8n-nodes-adlane",
	"version": "4.0.0",
	"description": "Ad library search for n8n by Adlane: see competitor ads on Meta, TikTok, LinkedIn and Google at once, save ad creative to boards and track competitors with the Adlane REST API.",
	"license": "MIT",
	"homepage": "https://adlane.app",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"adlane",
		"ad-library",
		"ad-library-search",
		"competitor-ads",
		"ad-spy",
		"ad-creative",
		"ad-intelligence",
		"meta-ad-library",
		"competitor-research"
	],
	"author": {
		"name": "Adlane",
		"url": "https://adlane.app",
		"email": "support@adlane.app"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adlane-app/n8n-nodes-adlane.git"
	},
	"bugs": {
		"url": "https://github.com/adlane-app/n8n-nodes-adlane/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint && eslint . --max-warnings=0",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test tests/*.test.cjs",
		"prepublishOnly": "npm test && npm run review",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"review": "npm run format:check && npm run lint && node scripts/review.mjs"
	},
	"files": [
		"dist",
		"examples"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AdlaneOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Adlane/Adlane.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.51.4",
		"@n8n/scan-community-package": "0.38.0",
		"@types/node": "22.19.15",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
